# ESCAPE 13 — copy to .env.local (never commit real values).
# PUBLIC: shipped to the browser. Only the Supabase URL and the publishable (anon) key belong here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY: never prefix with NEXT_PUBLIC_. Set in Vercel as encrypted (non-public) variables.
SUPABASE_SECRET_KEY=            # service-role / secret key: bypasses RLS
SUPABASE_JWT_SECRET=            # signs the short-lived Realtime tokens (Settings > API > JWT secret)
PAIRING_SECRET=                 # >= 32 random chars (openssl rand -base64 48); HMAC key for pairing codes + credentials
APP_BASE_URL=http://localhost:3000   # exact public origin, no trailing slash; used for the CSRF Origin check and QR links
