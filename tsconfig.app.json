{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "jsx": "preserve", "skipLibCheck": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["typecheck/stubs.d.ts", "tests/shims.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
